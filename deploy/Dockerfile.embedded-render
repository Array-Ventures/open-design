# Build context is produced by scripts/build-embedded-render.ts, not the source
# checkout. The host starts this worker with no network or credential mounts.
ARG TARGETARCH
FROM scratch AS pandoc-arm64
ADD --checksum=sha256:21e1d4ba09bd0b334590d204580fd4f6629b21be4ab6a32b26cc98982e9e0c68 https://github.com/jgm/pandoc/releases/download/3.13/pandoc-3.13-linux-arm64.tar.gz /pandoc.tgz
FROM scratch AS pandoc-amd64
ADD --checksum=sha256:38aa33b325a2bc96a4c39409631212db55702f564250bcdbead180b3bf646389 https://github.com/jgm/pandoc/releases/download/3.13/pandoc-3.13-linux-amd64.tar.gz /pandoc.tgz
FROM pandoc-${TARGETARCH} AS document-converter
FROM node:24.21.0-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends chromium ffmpeg fonts-dejavu-core fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
COPY --from=document-converter /pandoc.tgz /tmp/pandoc.tgz
RUN tar -xzf /tmp/pandoc.tgz -C /tmp && install /tmp/pandoc-3.13/bin/pandoc /usr/local/bin/pandoc && rm -rf /tmp/pandoc*
ADD --checksum=sha256:3ebfbf9235b049d384cdba5a66a1a3434bb544391e720b76faa8e1b3ee61a4e5 https://raw.githubusercontent.com/jgm/pandoc/3.13/COPYING.md /usr/share/licenses/pandoc/COPYING.md
LABEL org.evebot.document-converter="pandoc-3.13" org.evebot.document-converter-source="https://github.com/jgm/pandoc/tree/3.13"
WORKDIR /opt/render
COPY worker.mjs provenance.json hyperframe.runtime.iife.js deck-export.iife.js document-color.iife.js dom-to-pptx.bundle.js ./
COPY licenses ./licenses
COPY node_modules/playwright-core ./node_modules/playwright-core
ENV HOME=/tmp XDG_CACHE_HOME=/tmp
USER node
ENTRYPOINT ["node", "/opt/render/worker.mjs"]
